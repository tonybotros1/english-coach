# Copy this file to .env.local and fill in your own values.
# Never commit .env.local. On Vercel, add the same keys under Project Settings > Environment Variables.

# MongoDB Atlas: use a database user that can only access the english_coach database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=english_coach

# Random secret used to sign sign-in tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Resend (morning email and sign-in codes). Leave empty in local development:
# codes are then printed in the server console and returned to the app.
RESEND_API_KEY=
EMAIL_FROM=English Coach <onboarding@resend.dev>

# Google Gemini (free tier) from https://aistudio.google.com/apikey  (used from Phase 2)
GEMINI_API_KEY=

# Azure AI Speech, free F0 tier. Region is shown on the resource's "Keys and Endpoint" page.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uaenorth
# Optional: only if your resource uses a custom endpoint such as https://NAME.cognitiveservices.azure.com
AZURE_SPEECH_ENDPOINT=

# Browser origins allowed to call the API (the Expo web preview). Native apps do not need this.
CORS_ORIGINS=http://localhost:8081
